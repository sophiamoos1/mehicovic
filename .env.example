# Kopieren nach .env.local und ausfüllen (.env.local wird nicht committet).

# Postgres, z. B. von Neon (gratis): Connection String aus dem Neon-Dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Geheimer Schlüssel für Sessions: erzeugen mit  npx auth secret  oder  openssl rand -base64 32
AUTH_SECRET=""

# Dein einziger Account, wird mit  npm run db:seed  angelegt
SEED_EMAIL="deine@mail.ch"
SEED_PASSWORD="ein-langes-passwort"
